import React, { useEffect, useMemo, useRef, useState } from 'react';
import { useQuery, useMutation } from 'react-query';
import { getMe } from '../api/auth';
import { getMessages, sendMessage, getMyConversation, listConversations } from '../api/chat';
import { getSocket } from '../socket';
import { useNavigate } from 'react-router-dom';

export const ChatPage: React.FC = () => {
  const navigate = useNavigate();
  const accessToken = localStorage.getItem('accessToken');
  
  // Redirect to login if no token
  useEffect(() => {
    if (!accessToken) {
      navigate('/login');
    }
  }, [accessToken, navigate]);
  
  const { data: me, isLoading: meLoading } = useQuery('me', getMe, {
    enabled: !!accessToken,
    onError: () => {
      localStorage.removeItem('accessToken');
      navigate('/login');
    },
  });

  const [activeConversationId, setActiveConversationId] = useState<string | null>(null);
  const [messages, setMessages] = useState<any[]>([]);
  const bottomRef = useRef<HTMLDivElement | null>(null);
  const [isTyping, setIsTyping] = useState(false);
  const [input, setInput] = useState('');

  const socket = useMemo(() => (accessToken ? getSocket(accessToken) : null), [accessToken]);

  // User: get own conversation; Admin: list all conversations
  const { data: convData } = useQuery(
    ['conversation', me?.isAdmin],
    () => (me?.isAdmin ? listConversations() : getMyConversation()),
    { 
      enabled: !!me,
      onSuccess: (data) => {
        console.log('Conversation data:', data);
        console.log('Is admin:', me?.isAdmin);
      },
    },
  );

  useEffect(() => {
    if (!me || !convData) return;
    if (!me.isAdmin) {
      // User: auto-select conversation
      setActiveConversationId(convData.id);
    }
  }, [me, convData]);

  const { refetch: refetchMessages } = useQuery(
    ['messages', activeConversationId],
    () => getMessages(activeConversationId!),
    {
      enabled: !!activeConversationId,
      onSuccess: (data) => setMessages(data.reverse()),
      refetchOnMount: true,
    },
  );

  // Refetch messages when active conversation changes
  useEffect(() => {
    if (activeConversationId) {
      refetchMessages();
    }
  }, [activeConversationId, refetchMessages]);

  useEffect(() => {
    if (!socket || !activeConversationId) return;
    socket.emit('conversation:join', { conversationId: activeConversationId });

    socket.on('message:new', (msg: any) => {
      if (msg.conversationId === activeConversationId) {
        setMessages((prev) => [...prev, msg]);
      }
    });

    socket.on('typing', (payload: any) => {
      setIsTyping(payload.isTyping);
    });

    return () => {
      socket.off('message:new');
      socket.off('typing');
    };
  }, [socket, activeConversationId]);

  useEffect(() => {
    bottomRef.current?.scrollIntoView({ behavior: 'smooth' });
  }, [messages]);

  const mutation = useMutation((content: string) => sendMessage(activeConversationId!, content), {
    onSuccess: (msg) => {
      setMessages((prev) => [...prev, msg]);
    },
  });

  const handleSend = () => {
    if (!input.trim() || !activeConversationId) return;
    mutation.mutate(input);
    setInput('');
  };

  const handleKeyDown = (e: React.KeyboardEvent) => {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      handleSend();
    }
  };

  if (meLoading) {
    return (
      <div className="h-screen flex items-center justify-center">
        <p className="text-gray-600">Betöltés...</p>
      </div>
    );
  }

  return (
    <div className="h-screen flex">
      {me?.isAdmin && (
        <aside className="w-64 border-r overflow-y-auto bg-white">
          <div className="p-4 border-b">
            <h2 className="font-bold text-lg">Beszélgetések</h2>
          </div>
          {Array.isArray(convData) &&
            convData.map((conv: any) => (
              <div
                key={conv.id}
                className={`p-4 border-b cursor-pointer hover:bg-slate-50 ${
                  activeConversationId === conv.id ? 'bg-blue-50' : ''
                }`}
                onClick={() => setActiveConversationId(conv.id)}
              >
                <p className="font-semibold">{conv.user.username}</p>
                <p className="text-sm text-gray-500">{conv.user.email}</p>
              </div>
            ))}
        </aside>
      )}
      <main className="flex-1 flex flex-col bg-slate-50">
        {!activeConversationId ? (
          <div className="flex-1 flex items-center justify-center">
            <p className="text-gray-500">Válassz egy beszélgetést</p>
          </div>
        ) : (
          <>
            <div className="flex-1 overflow-y-auto p-4">
              {messages.map((m) => (
                <div
                  key={m.id}
                  className={`mb-3 flex ${m.senderId === me?.id ? 'justify-end' : 'justify-start'}`}
                >
                  <div
                    className={`px-4 py-2 rounded-lg max-w-xs break-words ${
                      m.senderId === me?.id ? 'bg-blue-500 text-white' : 'bg-white text-gray-900 shadow'
                    }`}
                  >
                    {m.content}
                  </div>
                </div>
              ))}
              {isTyping && (
                <div className="mb-3 flex justify-start">
                  <div className="px-4 py-2 rounded-lg bg-gray-200 text-gray-600 text-sm italic">
                    Partner gépel...
                  </div>
                </div>
              )}
              <div ref={bottomRef} />
            </div>
            <div className="border-t bg-white p-3">
              <div className="flex gap-2">
                <textarea
                  className="flex-1 border rounded px-3 py-2 resize-none focus:outline-none focus:ring-2 focus:ring-blue-500"
                  rows={2}
                  placeholder="Írj üzenetet..."
                  value={input}
                  onChange={(e) => {
                    setInput(e.target.value);
                    socket?.emit('typing', {
                      conversationId: activeConversationId,
                      isTyping: e.target.value.length > 0,
                    });
                  }}
                  onKeyDown={handleKeyDown}
                />
                <button
                  onClick={handleSend}
                  disabled={!input.trim() || mutation.isLoading}
                  className="px-6 py-2 bg-blue-500 text-white rounded hover:bg-blue-600 disabled:opacity-50 disabled:cursor-not-allowed"
                >
                  Küldés
                </button>
              </div>
            </div>
          </>
        )}
      </main>
    </div>
  );
};
